# 確認SQLの接続設定の見本。
# このファイルを .env という名前でコピーし、実際の値を入れる。
# .env はgitの管理外にしてある。見本（このファイル）には実際の値を書かない。
#
# 書き方: 1行に 名前=値。値を " か ' で囲むと、前後の空白も値に含められる。
# 行の途中の # はコメントにならず、値の一部として扱う。

# サーバー名。ポートやインスタンスがあれば server,1433 や server\instance と書く。
MSSQL_SERVER=

# SQL Server認証のユーザーID
MSSQL_USER=

# パスワード。空のままにすると、実行のたびに画面で入力を求める（おすすめ）。
MSSQL_PASSWORD=

# データベース名
MSSQL_DATABASE=GEMS_DM_S

# 通信を暗号化するか（true / false）
MSSQL_ENCRYPT=true

# サーバー証明書を検証せずに信頼するか（true / false）。
# 証明書のエラーで接続できず、SSMSでも「サーバー証明書を信頼する」を
# 有効にしている場合だけ true にする。
MSSQL_TRUST_SERVER_CERTIFICATE=false

# 1本のSQLの実行時間の上限（秒）。V-08の上限30分より長くしておく。
MSSQL_COMMAND_TIMEOUT_SEC=3600
